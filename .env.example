# LLM (optional — agent falls back to deterministic planner/synthesizer without it)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=  # for Azure/OpenRouter/local gateways
# Or use Azure/Anthropic/etc — set the relevant key

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# PostgreSQL (pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=financial_agent

# Redis (RedisStack — RediSearch/ReJSON modules required by the LangGraph checkpointer)
REDIS_URL=redis://localhost:6379/0

# Observability (optional)
LANGSMITH_API_KEY=
MLFLOW_TRACKING_URI=http://localhost:5000
